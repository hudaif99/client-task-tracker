PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=client_tracker_dev
PGUSER=client_tracker_app
PGPASSWORD="application_account_password"

# Generate a private random value locally; never commit the real secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4000

# For one HTTPS site behind a local Caddy proxy, set BETTER_AUTH_URL to that
# site's origin and enable this. Keep Express bound to 127.0.0.1.
# Caddy must overwrite X-Forwarded-For with the connecting client's address.
TRUST_LOOPBACK_PROXY=false
